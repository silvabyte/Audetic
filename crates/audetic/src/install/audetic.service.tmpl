[Unit]
Description=Audetic Voice Transcription Service
Documentation=https://github.com/silvabyte/Audetic
# Start only once the desktop has imported its Wayland/X11 environment.
# Ordering after a target alone does not pull it in or wait for a future login.
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=__EXEC_START__
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
Environment="RUST_LOG=info"

# Security and resource limits.
# Audetic's config/data directories exist before startup. The optional (`-`)
# Hyprland path may be created later without failing the service namespace.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__CONFIG_DIR__ __DATA_DIR__ -__HYPRLAND_CONFIG_DIR__
# Whisper models can need significant memory.
MemoryMax=6G
CPUQuota=80%

[Install]
WantedBy=graphical-session.target
